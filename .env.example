# TaskWizard v2 配置模板。复制为 .env 后填入实际值。
# 解析优先级：CLI 覆盖 > shell env > .env（仅 PHONE_AGENT_ 前缀）> 默认。

# === 模型（必填）===
PHONE_AGENT_BASE_URL="http://localhost:8000/v1"
PHONE_AGENT_MODEL="autoglm-phone-9b"
PHONE_AGENT_API_KEY="EMPTY"
PHONE_AGENT_MODEL_TIMEOUT="180"
PHONE_AGENT_MODEL_MAX_RETRIES="2"

# 采样参数：仅在网关/模型有限制时覆盖（如某模型只允许 temperature=1）。
# PHONE_AGENT_TEMPERATURE="1.0"
# PHONE_AGENT_TOP_P="0.95"
# PHONE_AGENT_FREQUENCY_PENALTY="0"

# 请求头：自建网关在 Cloudflare 后时必须浏览器 UA（默认已内置）；CF Access 需成对配置。
# PHONE_AGENT_USER_AGENT=""
# PHONE_AGENT_HTTP_HEADERS="X-Custom=v1;X-Other=v2"
# PHONE_AGENT_CF_ACCESS_CLIENT_ID=""
# PHONE_AGENT_CF_ACCESS_CLIENT_SECRET=""

# === 设备 ===
PHONE_AGENT_DEVICE_ID=""

# === App-KB 本机应用知识 ===
# 本地记忆根目录；App-KB 写入 <目录>/app_kb/{events.jsonl,kb.json}。
PHONE_AGENT_MEMORY_DIR="memory"
# Web runner 的独立 IPC 目录；每个 run 写 events/control/run.json 与 runner.pid。
PHONE_AGENT_RUNS_DIR="memory/runs"
# App-KB 总开关：默认开启；0/false/no/off 关闭同步、读取和 prompt 清单。
PHONE_AGENT_APP_KB="true"
# 隐式纠正写回：on（默认）| off。仅当同 run 的 unknown 回执列出包名，且之后该包名启动成功时记 learned 别名。
PHONE_AGENT_IMPLICIT_ALIAS="on"
# dream 覆盖错误 learned 别名：on（默认）| off。要求同 run 的秒退、模型明确自述和随后成功启动形成闭环。
PHONE_AGENT_ALIAS_OVERWRITE="on"
# 逗号分隔的模型“开错应用”自述词表；只持久化命中的词，不保存完整 note。
PHONE_AGENT_ALIAS_OVERWRITE_NOTES="开错,不对,不是,错了,wrong app"
# system prompt 中本机可启动应用规范名的最大数量。
PHONE_AGENT_APP_LIST_MAX="40"
# off | auto | manual（默认）。auto 在每次 run 后只合并+对账、不删除；manual 仅 --dream。
PHONE_AGENT_DREAM="manual"

# === App 名解析（候选生成 -> 证据类型化 -> 三态决策）===
# typed（默认）按 match_type 决策；legacy 回退旧 score 阈值语义。
PHONE_AGENT_RESOLVER_DECISION_MODE="typed"
# legacy 专用：top1 最低分与领先 top2 的最小分差。
PHONE_AGENT_RESOLVER_MIN_SCORE="0.90"
PHONE_AGENT_RESOLVER_MARGIN="0.08"
# typed 专用：强证据 top1 领先 top2 的最小 rank_score 分差。
PHONE_AGENT_RESOLVER_TYPED_MARGIN="0.08"
# 失败回执和 trace 最多保留的排序候选数。
PHONE_AGENT_RESOLVER_TOP_K="10"
# 四路候选中的可选路线；exact 始终开启。pinyin 缺依赖、embedding 缺索引时 fail-open 跳过。
PHONE_AGENT_RESOLVER_LEXICAL="on"
PHONE_AGENT_RESOLVER_PINYIN="on"
PHONE_AGENT_RESOLVER_EMBED="on"
# typed 包名分段：按 ./_/-/camelCase 切分，过滤停用词；mention 等于完整段且长度达标才算强证据。
PHONE_AGENT_RESOLVER_PACKAGE_SEGMENT_MIN_LEN="4"
PHONE_AGENT_RESOLVER_PACKAGE_SEGMENT_STOPWORDS="com,org,net,android,example,app,mobile,free,debug,release"
PHONE_AGENT_RESOLVER_AUTO_MATCH_TYPES="exact_alias,exact_label,exact_package,exact_package_segment,registered_containment"
PHONE_AGENT_RESOLVER_CLARIFY_MATCH_TYPES="fuzzy,pinyin_full,pinyin_initials,embedding"
# L3 排序：rank_score = W_SIM * sim + W_PRIOR * prior；typed 模式下只排序/回执/trace，不单独授权启动。
PHONE_AGENT_RESOLVER_W_SIM="0.8"
PHONE_AGENT_RESOLVER_W_PRIOR="0.2"

# === 经验数据面（observe-only，不回注 actor）===
# on（默认）| off；关闭后不创建、不写入任何 experience 文件。
PHONE_AGENT_EXPERIENCE="on"
# 追加日志 events.jsonl 与可重建物化视图 episodes.json 的目录。
PHONE_AGENT_EXPERIENCE_DIR="memory/experience"
# dream 后最多保留的完整 episode 数；更老记录仅保留按任务类别聚合的成功率。
PHONE_AGENT_EPISODE_KEEP="500"
# 超过该天数的完整 episode 在 dream 时归档（即使尚未超过数量上限）。
PHONE_AGENT_EPISODE_ARCHIVE_DAYS="90"

# === 经验提炼与人工晋升（离线产提案，只有 approved 可受控回注）===
# manual（默认）仅允许显式 CLI；off 会拒绝 --distill。
PHONE_AGENT_EVOLUTION="manual"
# lesson_proposed/approved/revoked/superseded 追加日志及可重建视图目录。
PHONE_AGENT_LESSONS_DIR="memory/lessons"
# === RAG 语义召回与受控 lesson 回注（默认 shadow，只观测不注入 actor）===
# off | shadow（默认）| on。on 在 run 开局仅注入人工 approved lesson 的 L0 Mirror；
# proposed/revoked 永不注入，缺失或损坏时 fail-open。
# detached runner 可通过 control.jsonl 的 revoke_lesson 立即撤销 store 并阻止后续注入；
# 已经发给模型的历史上下文不可撤回。
PHONE_AGENT_MEMORY_RAG="shadow"
# on 档最多注入的 lesson 数与按正文 len//4 估算的 token 总上限；0 可禁用。
PHONE_AGENT_LESSON_INJECT_MAX="3"
PHONE_AGENT_LESSON_INJECT_TOKENS="800"
# MLX embedder 第一次真正向量化时才加载模型；空索引/关闭时不加载。
PHONE_AGENT_EMBED_MODEL="Qwen/Qwen3-Embedding-0.6B"
PHONE_AGENT_EMBED_DIM="1024"
# sqlite-vec 派生索引；run 结束增量 upsert，dream 对账，也可显式全量重建。
PHONE_AGENT_VEC_DB="memory/vec.db"
# 少于该步数的短 episode 只留档、不进入语义索引；alias 不受此闸。
PHONE_AGENT_INDEX_MIN_STEPS="2"
# 仅表示 episode 语义榜名额；app mention 走独立确定性榜，不占名额。
PHONE_AGENT_RECALL_TOP_K="1"
# 基于实测噪音分布的起始门槛，可按部署重标定。
PHONE_AGENT_RECALL_MIN_SCORE="0.50"
# 仅用于语义同分时的 recency 决胜，不再直接加到相关性分数中。
PHONE_AGENT_RECALL_DECAY_LAMBDA="0.02"

# === Loop（死循环兜底保险丝）===
# 单次 run 允许的最大模型调用数（ModelCallLimit 硬停）。A4 起这是"防跑飞"保险丝，
# 不再是成本预算——成本预算见下方 Token 预算。终局 loop_fuse。
PHONE_AGENT_MAX_STEPS="100"
PHONE_AGENT_LANG="cn"
# 外层 HITL resume 上限（与单次 invoke 的模型调用预算正交；耗尽 → hitl_resume_exhausted）。
PHONE_AGENT_MAX_HITL_RESUMES="20"

# === Token 预算（L0 镜子预警 + 硬成本上限）===
# 累计 usage_metadata 的 input+output token 为成本口径（缺失时回退 len//4+图1500 估算）。
# 总预算：达到即硬停本次 run（终局 token_budget_exhausted）。
PHONE_AGENT_TOKEN_BUDGET="1000000"
# 绝对余量预警：剩余预算降到该值时注入一次"余量镜像"（给完整选项：finish/写任务板/收敛路线/take_over）。
PHONE_AGENT_TOKEN_WARN_REMAINING="100000"

# === 两级 auto-compact（上下文接近窗口时折叠远古段）===
# 总开关：on（默认）| 0/false/no/off 关闭。
PHONE_AGENT_COMPACT="on"
# T1 预警比例：上下文 token 估算 ≥ 窗口×该比例时注入一次"写任务板/收尾松散探索"提示。
PHONE_AGENT_COMPACT_WARN_RATIO="0.75"
# T2 强制比例：≥ 窗口×该比例时调一次纯文本 LLM 生成手机版结构化 handoff 摘要替换远古段。
PHONE_AGENT_COMPACT_TRIGGER_RATIO="0.92"
# 上下文窗口大小（token）。留空则按模型名推断（默认 256k）。
# PHONE_AGENT_CONTEXT_WINDOW="262144"

# === 上下文卫生（视觉回流 / 记忆卫生）===
# 历史保留的截图数（更旧的图剪除为 [screen#n 已剪除] 占位；至少 1）。
PHONE_AGENT_IMAGE_KEEP="2"
# 历史保留完整 marks digest 的 OBS 数（更旧的折叠为一行 [marks 已折叠:K]；至少 1）。
PHONE_AGENT_OBS_MARKS_KEEP="2"

# === Grounding ===
PHONE_AGENT_GROUNDING_PROVIDER="hybrid"   # hybrid | accessibility | locateanything
# 观测前全局静置（毫秒；0=关闭）。执行工具的 settle_ms 会替代而非叠加此值。
PHONE_AGENT_OBSERVE_SETTLE_MS="300"
# on（默认）检测 screencap 返回的均匀黑保护页；off 关闭。
PHONE_AGENT_BLACK_SCREEN_DETECT="on"
PHONE_AGENT_ACCESSIBILITY_TIMEOUT="3.0"
PHONE_AGENT_ACCESSIBILITY_MAX_MARKS="80"
# 窗口感知 marks（纯展示层）：auto|on|off。auto（默认）先试 uiautomator dump
# --windows，设备不支持则回退旧的单根 dump；on 强制 --windows（不支持则报错可见）；
# off 保持旧的平铺渲染。仅影响 marks 分组/标注/渲染——寻址、工具执行、安全门、
# 折叠、locate 一寸不动，op=blocked 仅展示不拦截。
PHONE_AGENT_MARKS_WINDOWED="auto"
PHONE_AGENT_LOCATEANYTHING_MODEL="models/LocateAnything-3B-4bit"
PHONE_AGENT_LOCATEANYTHING_MAX_SIZE="960"
# LA 指令中 intent / visible_text_hint 的单字段字符上限。
PHONE_AGENT_LOCATEANYTHING_CONTEXT_MAX_CHARS="200"
# locate 工具专用输入档位：0=原图（默认）；>0=最长边像素上限。
PHONE_AGENT_LOCATE_MAX_SIZE="0"
# scope 裁剪框四边按区域宽高扩展的比例。
PHONE_AGENT_SCOPE_PADDING_RATIO="0.05"
# U1: 关闭并行 tool calls（缺省关闭，薄环一次观测一次动作）。仅当网关拒绝该参数时设为 true。
PHONE_AGENT_PARALLEL_TOOL_CALLS="false"

# === TaskDoc 任务板 ===
PHONE_AGENT_TASKDOC="true"                # 0/false/no/off 关闭（不注册工具不渲染）
PHONE_AGENT_TASKDOC_NUDGE_STEPS="5"       # 【已废弃/no-op】U3 用流程线替代停滞轻推；保留仅为兼容，不再生效

# === 单页 HTML 产出物 ===
# on（默认）| off；开启时通过 C2 挂载 write_document / update_document。
# 文件固定为 <目录>/<run_id>.html，模型不能传路径；单份 UTF-8 HTML 上限 256 KiB。
PHONE_AGENT_DELIVERABLE="on"
PHONE_AGENT_DELIVERABLE_DIR="outputs/deliverables"

# === Trace ===
PHONE_AGENT_TRACE="true"
PHONE_AGENT_TRACE_DIR=".traces"

# === finish 两段式复核 + 独立验收器 ===
# off | auto（默认）| always。off 退化为旧的单段落定（向后兼容）；auto/always 先给
# 复核包（世界镜像+路线+疑点+选项），再由 finish(confirm=true) 定稿。
# auto：仅高风险目标（goal 命中支付/删除/凭据词表）或硬矛盾下坚持 confirm 时触发
# 独立 context 验收器；always：每次 confirm 都过验收器。验收器故障 fail-open（放行）。
PHONE_AGENT_FINISH_VERIFY="auto"
# 验收器看几帧尾部截图（K=1 用当前帧；K>1 需历史帧保留能力）。
PHONE_AGENT_FINISH_VERIFY_K="1"
# finish 独立验收模型，缺省回落主模型。
# PHONE_AGENT_VERIFIER_MODEL=""

# === 安全（预警制：宽召回 → 精排 → 预警）===
# off | wary（默认）| hard | reviewer。
# wary：预警制——检出风险的执行类调用（tap/long_press/type_text/launch_app）不执行、也不叫人，
#       工具返回一段预警（世界事实 + 选项）；模型带 confirm_irreversible=true 重发才执行。
#       同时 harness 打印一条非阻塞提示（stdout + trace），不做桌面通知。
# hard：旧 HITL 硬拦——风险执行类调用中断等人工 approve/reject（挂机/无人值守用）。
# off：actuation 全不门控（take_over/ask_user 仍中断），用于长期低摩擦跑批。
# reviewer：wary + 软候选过第二模型精排（判可逆性）；模型不可用/异常 → fail-closed 预警。
PHONE_AGENT_SAFETY_MODE="wary"
# 安全精排模型，缺省回落 VERIFIER_MODEL 再回落主模型。
# PHONE_AGENT_SAFETY_REVIEWER_MODEL=""

# === 压缩/记忆模型 ===
# auto-compact 生成 handoff 摘要用的纯文本模型，缺省回落主模型。
# PHONE_AGENT_MEMORY_MODEL=""

# === 诊断证据流（live-diagnosis skill 专用；默认关闭、关闭时零成本）===
# 生产默认关闭；由 skill 打开，向 <run_dir>/<run_id>.evidence.jsonl 写全文证据，并把
# 截图解码落盘到 <run_dir>/screenshots/screen-<seq>.png（JSONL 仍永不含 base64）。
# 不影响 P0 #6 生产 trace（trace.py 永远 64 字截断 + 脱敏 + 无 base64）。
# PHONE_AGENT_DIAG_EVIDENCE="false"
# PHONE_AGENT_DIAG_EVIDENCE_DIR="outputs/live-diagnosis/.evidence"
# 全保真模式（本机自用）：证据流不脱敏、不截断（仍多模态 text/image 拆分、JSONL 仍无 base64）。
# 由 skill 在诊断模式置真；脱敏只在显式 --share 副本里恢复。
# PHONE_AGENT_DIAG_UNREDACTED="false"
