# Open-AutoGLM v2 配置模板。复制为 .env 后填入实际值。
# 解析优先级：CLI 覆盖 > shell env > .env（仅 PHONE_AGENT_ 前缀）> 默认。

# === 模型（必填）===
PHONE_AGENT_BASE_URL="http://localhost:8000/v1"
PHONE_AGENT_MODEL="autoglm-phone-9b"
PHONE_AGENT_API_KEY="EMPTY"
PHONE_AGENT_MODEL_TIMEOUT="180"
PHONE_AGENT_MODEL_MAX_RETRIES="2"

# 采样参数：仅在网关/模型有限制时覆盖（如某模型只允许 temperature=1）。
# PHONE_AGENT_TEMPERATURE="1.0"
# PHONE_AGENT_TOP_P="0.95"
# PHONE_AGENT_FREQUENCY_PENALTY="0"

# 请求头：自建网关在 Cloudflare 后时必须浏览器 UA（默认已内置）；CF Access 需成对配置。
# PHONE_AGENT_USER_AGENT=""
# PHONE_AGENT_HTTP_HEADERS="X-Custom=v1;X-Other=v2"
# PHONE_AGENT_CF_ACCESS_CLIENT_ID=""
# PHONE_AGENT_CF_ACCESS_CLIENT_SECRET=""

# === 设备 ===
PHONE_AGENT_DEVICE_ID=""

# === Loop（死循环兜底保险丝）===
# 单次 run 允许的最大模型调用数（ModelCallLimit 硬停）。A4 起这是"防跑飞"保险丝，
# 不再是成本预算——成本预算见下方 Token 预算。终局 loop_fuse。
PHONE_AGENT_MAX_STEPS="100"
PHONE_AGENT_LANG="cn"
# 外层 HITL resume 上限（与单次 invoke 的模型调用预算正交；耗尽 → hitl_resume_exhausted）。
PHONE_AGENT_MAX_HITL_RESUMES="20"

# === Token 预算（L0 镜子预警 + 硬成本上限）===
# 累计 usage_metadata 的 input+output token 为成本口径（缺失时回退 len//4+图1500 估算）。
# 总预算：达到即硬停本次 run（终局 token_budget_exhausted）。
PHONE_AGENT_TOKEN_BUDGET="1000000"
# 绝对余量预警：剩余预算降到该值时注入一次"余量镜像"（给完整选项：finish/写任务板/收敛路线/take_over）。
PHONE_AGENT_TOKEN_WARN_REMAINING="100000"

# === 两级 auto-compact（上下文接近窗口时折叠远古段）===
# 总开关：on（默认）| 0/false/no/off 关闭。
PHONE_AGENT_COMPACT="on"
# T1 预警比例：上下文 token 估算 ≥ 窗口×该比例时注入一次"写任务板/收尾松散探索"提示。
PHONE_AGENT_COMPACT_WARN_RATIO="0.75"
# T2 强制比例：≥ 窗口×该比例时调一次纯文本 LLM 生成手机版结构化 handoff 摘要替换远古段。
PHONE_AGENT_COMPACT_TRIGGER_RATIO="0.92"
# 上下文窗口大小（token）。留空则按模型名推断（默认 256k）。
# PHONE_AGENT_CONTEXT_WINDOW="262144"

# === 上下文卫生（视觉回流 / 记忆卫生）===
# 历史保留的截图数（更旧的图剪除为 [screen#n 已剪除] 占位；至少 1）。
PHONE_AGENT_IMAGE_KEEP="2"
# 历史保留完整 marks digest 的 OBS 数（更旧的折叠为一行 [marks 已折叠:K]；至少 1）。
PHONE_AGENT_OBS_MARKS_KEEP="2"

# === Grounding ===
PHONE_AGENT_GROUNDING_PROVIDER="hybrid"   # hybrid | accessibility | locateanything
PHONE_AGENT_ACCESSIBILITY_TIMEOUT="3.0"
PHONE_AGENT_ACCESSIBILITY_MAX_MARKS="80"
PHONE_AGENT_LOCATEANYTHING_MODEL="models/LocateAnything-3B-4bit"
PHONE_AGENT_LOCATEANYTHING_MAX_SIZE="960"

# === TaskDoc 任务板 ===
PHONE_AGENT_TASKDOC="true"                # 0/false/no/off 关闭（不注册工具不渲染）
PHONE_AGENT_TASKDOC_NUDGE_STEPS="5"       # 【已废弃/no-op】U3 用流程线替代停滞轻推；保留仅为兼容，不再生效

# === Trace ===
PHONE_AGENT_TRACE="true"
PHONE_AGENT_TRACE_DIR=".traces"

# === finish 两段式复核 + 独立验收器 ===
# off | auto（默认）| always。off 退化为旧的单段落定（向后兼容）；auto/always 先给
# 复核包（世界镜像+路线+疑点+选项），再由 finish(confirm=true) 定稿。
# auto：仅高风险目标（goal 命中支付/删除/凭据词表）或硬矛盾下坚持 confirm 时触发
# 独立 context 验收器；always：每次 confirm 都过验收器。验收器故障 fail-open（放行）。
PHONE_AGENT_FINISH_VERIFY="auto"
# 验收器看几帧尾部截图（K=1 用当前帧；K>1 需历史帧保留能力）。
PHONE_AGENT_FINISH_VERIFY_K="1"
# finish 独立验收模型，缺省回落主模型。
# PHONE_AGENT_VERIFIER_MODEL=""

# === 安全门（宽召回 → 精排 → 硬门）===
# off | hard（默认）| reviewer。
# off：actuation 全不门控（take_over/ask_user 仍中断），用于长期低摩擦跑批。
# hard：仅硬门（不可逆动词+密码框+凭据输入+自我申报）；软候选不弹窗（减少误报）。
# reviewer：硬门 + 软候选过第二模型精排（判可逆性）；模型不可用/异常 → fail-closed 弹窗。
PHONE_AGENT_SAFETY_MODE="hard"
# 安全精排模型，缺省回落 VERIFIER_MODEL 再回落主模型。
# PHONE_AGENT_SAFETY_REVIEWER_MODEL=""

# === 压缩/记忆模型 ===
# auto-compact 生成 handoff 摘要用的纯文本模型，缺省回落主模型。
# PHONE_AGENT_MEMORY_MODEL=""

# === 诊断证据流（live-diagnosis skill 专用；默认关闭、关闭时零成本）===
# 生产默认关闭；由 skill 打开，向 <run_dir>/<run_id>.evidence.jsonl 写全文证据，并把
# 截图解码落盘到 <run_dir>/screenshots/screen-<seq>.png（JSONL 仍永不含 base64）。
# 不影响 P0 #6 生产 trace（trace.py 永远 64 字截断 + 脱敏 + 无 base64）。
# PHONE_AGENT_DIAG_EVIDENCE="false"
# PHONE_AGENT_DIAG_EVIDENCE_DIR="outputs/live-diagnosis/.evidence"
# 全保真模式（本机自用）：证据流不脱敏、不截断（仍多模态 text/image 拆分、JSONL 仍无 base64）。
# 由 skill 在诊断模式置真；脱敏只在显式 --share 副本里恢复。
# PHONE_AGENT_DIAG_UNREDACTED="false"